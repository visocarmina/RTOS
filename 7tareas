void Tarea05(void *parameter) {
  while(1) {
    // Si la bandera 05 está activada decrementa el contador 05 en 1
    if(flag05 == 1){
      cont05--;
      ET05_estado = "Decrementando";
    }
    // Si la bandera 05 está desactivada incrementa el contador 05 en 1
    if(flag05 == 0){
      cont05++;
      ET05_estado = "Incrementando";
    }
    // Si el contador 05 llega al valor de 155 activamos la bandera 05
    if(cont05 == 155){ // El valor de 155 puede cambiarse a 255, solo es necesario calcular la resistencia conectada
      flag05 = 1;      // en serie necesaria para no quemar nuestro LED
    }
    // Si el contador 05 llega al valor de 0 desactivamos la bandera 05
    if(cont05 == 0){
      flag05 = 0;
    }
    analogWrite(pinO5, cont05); // Mandamos por el pin de salida el PWM
    vTaskDelay(periodo_T5 / portTICK_PERIOD_MS); // Retardo para volver a entrar a la Tarea 05
  }
}

void Tarea06(void *parameters){
  while(1){
    if(xSemaphoreTake(mutex,0)==pdTRUE){
      // Sección crítica
      mpu.getMotion6(&ax, &ay, &az, &gx, &gy, &gz);
      // Liberamos la sección crítica
      xSemaphoreGive(mutex);
    }
    else{

    }
    vTaskDelay(20/portTICK_PERIOD_MS);
    // Convertir los datos en unidades de medida
    float accelX = ax / 16384.0; // Sensibilidad del acelerómetro para el rango de ±2g
    float accelY = ay / 16384.0;
    float accelZ = az / 16384.0;
  
    float gyroX = gx / 131.0; // Sensibilidad del giroscopio para el rango de ±250°/s
    float gyroY = gy / 131.0;
    float gyroZ = gz / 131.0;

    /----- Angulos pich and roll a partir de un acelerometro/
    pitch = -(atan2(accelX, sqrt(accelY*accelY + accelZ*accelZ))*180.0)/M_PI;
    roll = ((atan2(accelY, accelZ)*180.0)/M_PI);
    /* Pasamos los grados a valores de 0 a 1023 con la finalidad de no tener negativos*/
    roll=map(roll,-180,180,0,1023);
    pitch=map(pitch,-180,180,0,1023);

    // Identificación de planos
    if(((200<pitch)&&(pitch<400))&&((0<roll)&&(roll<1023))){
      lado = 1; // Superior
    }
    else if(((600<pitch)&&(pitch<800))&&((0<roll)&&(roll<1023))){
      lado = 2; // Inferior
    }
    else if(((400<pitch)&&(pitch<600))&&((500<roll)&&(roll<540))){
      lado = 3; // Frontal
    }
    else if(((400<pitch)&&(pitch<600))&&(((0<roll)&&(roll<100))||((900<roll)&&(roll<1023)))){
      lado = 4; // Posterior
    }
    else if(((400<pitch)&&(pitch<600))&&((700<roll)&&(roll<900))){
      lado = 5; // Izquierdo
    }
    else if(((400<pitch)&&(pitch<600))&&((200<roll)&&(roll<400))){
      lado = 6;  // Derecho
    }
    else{
    }
    vTaskDelay(250/portTICK_PERIOD_MS); // Retardo para volver a entrar a la Tarea06
  }
}
void setup() {
  // Configuración de las entradas y las salidas
  pinMode(pinO1,OUTPUT);
  pinMode(pinI1,INPUT);
  pinMode(pinO3,OUTPUT);
  pinMode(pinI3,INPUT);
  attachInterrupt(digitalPinToInterrupt(pinI6),ISR_Interrupt, RISING); // Habilitamos las interrupciones por hardware en un pin
  
  Serial.begin(115200); // Inicializamos comunicación serial
  delay(1000);
  Serial.println("comunicación serial inicializada");
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) { // Address 0x3D for 128x64
    Serial.println(F("SSD1306 allocation failed"));
    for(;;);
  }
  display.clearDisplay();

  Wire.begin(); // Inicializamos comunicación I2C
  mpu.initialize();   // Inicializamos el MPU6050
  // Configurar el rango de escala del giroscopio y acelerómetro
  mpu.setFullScaleGyroRange(MPU6050_GYRO_FS_250);
  mpu.setFullScaleAccelRange(MPU6050_ACCEL_FS_2);

  // Crear Mutex antes de comenzar las tareas
  mutex =xSemaphoreCreateMutex();

  // Creación del Timer
  myTimer = xTimerCreate(
                        "myTimer",     // Name of timer
                        dim_delay,     // Period of timer (in ticks)
                        pdTRUE,        // Auto-reload
                        (void *)0,     // Timer ID
                        ISR_myTimer);  // Callback function
  // Creación del Timer
  myTimer06 = xTimerCreate(
                        "myTimer06",     // Name of timer
                        dim_delay,     // Period of timer (in ticks)
                        pdTRUE,        // Auto-reload
                        (void *)0,     // Timer ID
                        ISR_myTimer06);  // Callback function

  // Creación de Tareas
  xTaskCreate(Tarea01,"Tarea 01",1024,NULL,1,NULL);
  xTaskCreate(Tarea02,"Tarea 02",1024,NULL,1,NULL);
  xTaskCreate(Tarea03,"Tarea 03",1024,NULL,1,NULL);
  xTaskCreate(Tarea04,"Tarea 04",1024,NULL,1,NULL);
  xTaskCreate(Tarea05,"Tarea 05",1024,NULL,1,NULL);
  xTaskCreate(Tarea06,"Tarea 06",1024,NULL,1,NULL);

  // Inicializamos el Timer 
  if(myTimer != NULL){
    xTimerStart(myTimer,0);
  }else{
    Serial.println("---- Error al inicializar el Timer ----");
  } 
  // Inicializamos el timer myTimer06 
  if(myTimer06 != NULL){
    xTimerStart(myTimer06,0);
  }else{
    Serial.println("---- Error al inicializar el Timer ----");
  }
}

