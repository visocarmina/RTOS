// Declaración de Tareas
void Tarea01(void *parameters){
  while(1){
    // Si el botón está presionado
    if(digitalRead(pinI1) == 1){
      flag01 = 1; // Activamos bandera 01
      ET01_estado = "Botón presionado";
    }
    // Si el botón no está presionado
    if(digitalRead(pinI1) == 0){
      flag01 = 0; // Desactivamos bandera 01
      ET01_estado = "Botón no presionado";
    }
    // Cuando la bandera 01 se activa 
    if(flag01 == 1){
      cont++; // Incrementamos en 1 el contador
      // Mientras el contador sea menor a 3
      if(cont < 3){ 
        digitalWrite(pinO1,HIGH); // Led se mantiene encendido
      }
      // Cuando el contador sea mayor o igual a 3 
      if(cont >= 3){
        toogle = !toogle;
        digitalWrite(pinO1,toogle); // El Led cambia de estado
        cont = 3; // Saturamos el contador en 3
      }
      vTaskDelay(1000/portTICK_PERIOD_MS); // Tiempo de espera de 1 seg para que vuelva a ingresar a la Tarea 01
    }
    // Si no
    else{
      cont = 0; // Reseteamos el contador
      digitalWrite(pinO1,LOW); // Apagamos Led
      toogle = 0; // Reseateamos la variable de toogle
    }
  }
}

